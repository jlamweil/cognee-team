# cognee-team server configuration — TEMPLATE.
# install_server.sh copies this to .env and injects generated secrets.
# Never commit .env (gitignored): it holds JWT secrets and API keys.

# --- Security posture (do not weaken) ---------------------------------------
ENABLE_BACKEND_ACCESS_CONTROL=true
REQUIRE_AUTHENTICATION=true

# --- Storage (installer rewrites the absolute paths for its host) -----------
SYSTEM_ROOT_DIRECTORY=__DATA_ROOT__/data
COGNEE_LOGS_DIR=__DATA_ROOT__/data/logs
COGNEE_REPOS_DIR=__DATA_ROOT__/data/repos

# --- Isolation-capable backends (required for tiering to be enforced) -------
DB_PROVIDER=sqlite
VECTOR_DB_PROVIDER=lancedb
GRAPH_DATABASE_PROVIDER=kuzu

# --- PROVEN local extraction stack ------------------------------------------
# custom + openai/<model> via Ollama's OpenAI-compatible /v1 + json_mode.
# Validated end-to-end with qwen2.5:7b-instruct (~5 GB RAM); gemma3/llama3.2
# at small sizes fail schema discipline. Needs Ollama: `ollama pull qwen2.5:7b-instruct`.
LLM_PROVIDER=custom
LLM_MODEL=openai/qwen2.5:7b-instruct
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=ollama
STRUCTURED_OUTPUT_FRAMEWORK=instructor
LLM_INSTRUCTOR_MODE=json_mode
COGNEE_SKIP_CONNECTION_TEST=true
LLM_ARGS={"parallel_tool_calls": false}
OLLAMA_NUM_CTX=8192

# Embeddings: in-process ONNX — no server, no length 422s.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# --- Secrets (installer injects; restart-stable) ----------------------------
FASTAPI_USERS_JWT_SECRET=__GENERATE__
FASTAPI_USERS_RESET_PASSWORD_TOKEN_SECRET=__GENERATE__
FASTAPI_USERS_VERIFICATION_TOKEN_SECRET=__GENERATE__

# --- PRESET: Albert (etalab) gpt-oss-120b — uncomment + paste key ------------
# LLM_PROVIDER=custom
# LLM_MODEL=openai/gpt-oss-120b
# LLM_ENDPOINT=https://albert.api.etalab.gouv.fr/v1
# LLM_API_KEY=<paste albert key>

